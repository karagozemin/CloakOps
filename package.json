{
  "name": "cloakops",
  "version": "0.1.0",
  "private": true,
  "description": "CloakOps — a confidential campaign layer for TokenOps. Private allocations, public rules, TokenOps execution.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "lint": "npm run lint --workspace apps/web",
    "compile": "npm run compile --workspace packages/contracts",
    "test": "npm run test --workspace packages/contracts",
    "deploy:sepolia": "npm run deploy:sepolia --workspace packages/contracts",
    "export-abi": "npm run export-abi --workspace packages/contracts"
  },
  "engines": {
    "node": ">=20"
  }
}
