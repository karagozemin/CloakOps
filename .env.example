# ---------------------------------------------------------------------------
# CloakOps environment template
#
# Root .env (Hardhat / deploy only):
#   SEPOLIA_RPC_URL, PRIVATE_KEY, ETHERSCAN_API_KEY
#
# apps/web/.env.local (Next.js frontend — copy the NEXT_PUBLIC_* and relayer
# vars below):
#   Contract addresses, TokenOps vesting URLs, WalletConnect, ZAMA_RELAYER_URL
#
# NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Network (frontend + contracts) ---
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_NETWORK_NAME=sepolia

# --- Deployed CloakOps contracts (filled in after `npm run deploy:sepolia`) ---
NEXT_PUBLIC_CLOAKOPS_CONTRACT_ADDRESS=
# CloakConfidentialToken — the confidential payout asset credited on claim.
NEXT_PUBLIC_CLOAKOPS_TOKEN_ADDRESS=

# --- TokenOps vesting (Sepolia — tracking page after UI deploy) ---
NEXT_PUBLIC_TOKENOPS_VESTING_SCHEDULE_ID=6a189b396f763543bff332be
NEXT_PUBLIC_TOKENOPS_VESTING_SCHEDULE_URL=https://app.tokenops.xyz/contract/schedules/6a189b396f763543bff332be
NEXT_PUBLIC_TOKENOPS_VESTING_CONTRACT=0xE1Fce9e572efFa42BBE851A44D2d00d2c808c494

# --- Zama FHE relayer (server-side proxy for /api/relayer/[chainId]) ---
ZAMA_RELAYER_URL=https://relayer.testnet.zama.org/v2
# Optional — required if Zama relayer returns 401:
# ZAMA_RELAYER_API_KEY=
# Set to false to call Zama relayer directly from the browser (CORS allows localhost):
# NEXT_PUBLIC_ZAMA_USE_RELAYER_PROXY=false

# --- WalletConnect (optional, enables more wallets) ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Contracts deployment (root .env, server-side only) ---
SEPOLIA_RPC_URL=
PRIVATE_KEY=
ETHERSCAN_API_KEY=
