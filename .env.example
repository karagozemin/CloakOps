# ---------------------------------------------------------------------------
# CloakOps environment configuration
# Copy this file to .env (root, for contracts) and apps/web/.env.local (frontend).
# NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Network (frontend + contracts) ---
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_NETWORK_NAME=sepolia

# --- Deployed CloakOps contract (filled in after `npm run deploy:sepolia`) ---
NEXT_PUBLIC_CLOAKOPS_CONTRACT_ADDRESS=

# --- TokenOps integration ---
# "demo" uses the bundled demo adapter (no credentials needed).
# "real" uses the @tokenops/sdk distribution rails (requires the values below).
NEXT_PUBLIC_TOKENOPS_MODE=demo
TOKENOPS_API_KEY=
TOKENOPS_API_BASE_URL=

# --- Zama FHE relayer (frontend dual-mode) ---
# "demo" uses deterministic local encryption so the demo never breaks.
# "real" uses the Zama Relayer SDK against the deployed contract.
NEXT_PUBLIC_ZAMA_MODE=real
# Server-only relayer proxy config (used by /api/relayer/[chainId]).
# Default Sepolia relayer (matches @zama-fhe/sdk SepoliaConfig):
ZAMA_RELAYER_URL=https://relayer.testnet.zama.org/v2
# Optional — required if Zama relayer returns 401:
# ZAMA_RELAYER_API_KEY=

# --- WalletConnect (optional, enables more wallets) ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Contracts deployment (root .env, server-side only) ---
SEPOLIA_RPC_URL=
PRIVATE_KEY=
ETHERSCAN_API_KEY=
